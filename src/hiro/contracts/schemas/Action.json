{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Action",
 "type": "object",
 "properties": {
  "kind": {
   "type": "string",
   "enum": [
    "ProduceNext",
    "ActivateEffect",
    "ExcludeCard",
    "Reroll",
    "ShopBuy",
    "ShopUpgradeCard",
    "ShopEnd",
    "EventSelect",
    "PresentReceive",
    "IntervalBuy",
    "IntervalUpgradeCard",
    "IntervalChangeCard",
    "IntervalEnd",
    "CustomizeCard",
    "CustomizeEnd",
    "SelectFormation",
    "ChangeCard",
    "RemoveCard",
    "EnhanceCard",
    "Dialog",
    "SelectQualifyMemory",
    "DiscardDrink",
    "PlayCard",
    "UseDrink",
    "Skip",
    "Continue",
    "Wait",
    "Recover",
    "Noop"
   ]
  },
  "args": {
   "type": "object",
   "additionalProperties": {}
  },
  "version": {
   "type": "string"
  }
 },
 "required": [
  "kind",
  "args",
  "version"
 ],
 "additionalProperties": false,
 "description": "一个要执行的动作。args 的键按 kind 固定（见各工厂方法），全部是 JSON 标量或列表。"
}
